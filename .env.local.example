# Vercel Blob token. Get it with `vercel env pull .env.local` after linking
# the project, or copy from the Vercel dashboard (Storage → Blob → .env tab).
BLOB_READ_WRITE_TOKEN=

# Login credentials. The server checks these on POST /api/login.
LOGIN=
PASSWORD=

# Secret used to sign auth tokens (HMAC-SHA256). Anything random works;
# changing it invalidates every existing session.
AUTH_SECRET=